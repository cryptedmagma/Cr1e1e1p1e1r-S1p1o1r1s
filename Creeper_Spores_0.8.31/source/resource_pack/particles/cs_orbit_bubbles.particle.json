{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cookiedookie:cs_orbit_bubbles",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/cs_trails"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 4,
        "max_particles": 4
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.0
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.9 + variable.particle_random_4 * 0.3"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(variable.particle_random_1 * 360 + variable.particle_age * 50) * (0.6 + variable.particle_random_2 * 0.3)",
          "variable.particle_random_3 * 1.3 - 0.55 + variable.particle_age * 0.25",
          "math.sin(variable.particle_random_1 * 360 + variable.particle_age * 50) * (0.6 + variable.particle_random_2 * 0.3)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.07 + variable.particle_random_2 * 0.06) * math.min(variable.particle_age / 0.12, 1)",
          "(0.07 + variable.particle_random_2 * 0.06) * math.min(variable.particle_age / 0.12, 1)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 88,
          "texture_height": 16,
          "uv": [
            48,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "math.min(variable.particle_age / 0.12, 1) * math.clamp((1 - variable.particle_age / variable.particle_lifetime) / 0.44999999999999996, 0, 1)"
        ]
      }
    }
  }
}