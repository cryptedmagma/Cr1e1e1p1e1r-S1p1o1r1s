{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.cookiedookie_creeper": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.default",
            "Texture.charged",
            "Texture.alt",
            "Texture.alt_charged"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.skins[(query.variant == 1 ? 2 : 0) + (query.is_charged ? 1 : 0)]"
      ],
      "overlay_color": {
        "r": 1,
        "g": 1,
        "b": 1,
        "a": "query.is_ignited ? (Math.mod(query.life_time * 10, 2) > 1 ? 0.7 : 0.0) : 0.0"
      }
    }
  }
}
